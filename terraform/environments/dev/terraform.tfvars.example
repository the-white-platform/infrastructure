project_id  = "the-white-dev"
environment = "dev"
region      = "europe-north1"

service_name = "fashion-web-dev"

# Container configuration
container_image = "us-docker.pkg.dev/cloudrun/container/hello"
container_port  = 3000

# Resource allocation
memory = "1Gi"
cpu    = "1"

# Scaling configuration
min_instances = 0
max_instances = 3

# Timeout
timeout_seconds = 300

# Access control
allow_unauthenticated = true

# Custom domain (optional)
# domain_name = "dev.thewhite.cool"

# Monitoring
enable_monitoring = true

# Environment variables
env_vars = {
  NODE_ENV                 = "development"
  NEXT_TELEMETRY_DISABLED = "1"
}

# Secrets from Secret Manager
secrets = {
  DATABASE_URI = {
    secret_name = "DATABASE_URI_DEV"
    version     = "latest"
  }
  PAYLOAD_SECRET = {
    secret_name = "PAYLOAD_SECRET_DEV"
    version     = "latest"
  }
  NEXT_PUBLIC_SERVER_URL = {
    secret_name = "NEXT_PUBLIC_SERVER_URL_DEV"
    version     = "latest"
  }
}

# Labels
labels = {
  environment = "dev"
  team        = "platform"
  managed-by  = "terraform"
}

# Ingress settings
ingress = "all"

# Execution environment
execution_environment = "gen2"
