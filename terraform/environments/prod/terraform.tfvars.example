project_id  = "the-white-dev"
environment = "prod"
region      = "europe-north1"

service_name = "fashion-web"

# Container configuration
container_image = "us-docker.pkg.dev/cloudrun/container/hello"
container_port  = 3000

# Resource allocation
memory = "2Gi"
cpu    = "2"

# Scaling configuration
min_instances = 2
max_instances = 10

# Timeout
timeout_seconds = 300

# Access control
allow_unauthenticated = false

# Custom domain
domain_name = "thewhite.cool"

# Monitoring
enable_monitoring = true

# Environment variables
env_vars = {
  NODE_ENV                 = "production"
  NEXT_TELEMETRY_DISABLED = "1"
}

# Secrets from Secret Manager
secrets = {
  PAYLOAD_SECRET = {
    secret_name = "PAYLOAD_SECRET"
    version     = "latest"
  }
  # DATABASE_URI is auto-injected by enable_cloud_sql = true
  NEXT_PUBLIC_SERVER_URL = {
    secret_name = "NEXT_PUBLIC_SERVER_URL"
    version     = "latest"
  }
}

# Labels
labels = {
  environment = "prod"
  team        = "platform"
  managed-by  = "terraform"
  critical    = "true"
}

# Ingress settings
ingress = "all"

# Execution environment
execution_environment = "gen2"

# ---------------------------------------------------------------------------------------------------------------------
# VERTEX AI VIRTUAL TRY-ON (VTO)
# ---------------------------------------------------------------------------------------------------------------------

# enable_vertex_vto      = true
# vto_bucket_name        = ""                # Leave empty to auto-generate
# vto_bucket_location    = "asia-southeast1"

# ---------------------------------------------------------------------------------------------------------------------
# CLOUD ARMOR / LOAD BALANCER
# ---------------------------------------------------------------------------------------------------------------------

# enable_cloud_armor                = true
# cloud_armor_rate_limit_threshold  = 100

# ---------------------------------------------------------------------------------------------------------------------
# VTO IMAGE LIFECYCLE
# ---------------------------------------------------------------------------------------------------------------------

# vto_image_retention_days = 30

# ---------------------------------------------------------------------------------------------------------------------
# BUDGET ALERT (set email to enable)
# ---------------------------------------------------------------------------------------------------------------------

# billing_account_id = "YOUR-BILLING-ACCOUNT-ID"
# vto_budget_amount  = 50
# budget_alert_email = "your-email@example.com"
