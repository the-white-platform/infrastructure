project_id  = "your-gcp-project-id"
environment = "staging"
region      = "europe-north1"

service_name = "fashion-web-staging"

# Container configuration
container_image = "gcr.io/your-gcp-project-id/fashion-web:latest"
container_port  = 3000

# Resource allocation
memory = "2Gi"
cpu    = "2"

# Scaling configuration
min_instances = 1
max_instances = 5

# Timeout
timeout_seconds = 300

# Access control
allow_unauthenticated = true

# Custom domain (optional)
# domain_name = "staging.thewhite.cool"

# Monitoring
enable_monitoring = true

# Environment variables
env_vars = {
  NODE_ENV                 = "production"
  NEXT_TELEMETRY_DISABLED = "1"
}

# Secrets from Secret Manager
secrets = {
  DATABASE_URI = {
    secret_name = "DATABASE_URI_STAGING"
    version     = "latest"
  }
  PAYLOAD_SECRET = {
    secret_name = "PAYLOAD_SECRET_STAGING"
    version     = "latest"
  }
  NEXT_PUBLIC_SERVER_URL = {
    secret_name = "NEXT_PUBLIC_SERVER_URL_STAGING"
    version     = "latest"
  }
}

# Labels
labels = {
  environment = "staging"
  team        = "platform"
  managed-by  = "terraform"
}

# Ingress settings
ingress = "all"

# Execution environment
execution_environment = "gen2"
